{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LCC",
  "version": "0.2.1",
  "identifier": "ru.loomixx.lcc",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Loomixx Control Center",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0N0ZERDNERDU5QkIwRkYKUldUL3NKdlZQZDEvZE5JOFBQNUR4UkliaGRzY0JOWCtCWnNuS01FRWFkYjVMMUVkQ1Z3MUlpY2gK",
      "endpoints": [
        "https://github.com/alekseevich47/controlcenter/releases/latest/download/latest.json"
      ]
    }
  }
}
